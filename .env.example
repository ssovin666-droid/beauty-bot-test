# Токен, который выдаст @BotFather
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# После запуска отправь боту /id и вставь сюда полученный Telegram ID.
# Если администраторов несколько: 123456789,987654321
ADMIN_IDS=

# Для локального запуска можно оставить так:
DB_PATH=beauty_bot.db

# На Railway с подключённым Volume рекомендуем:
# DB_PATH=/data/beauty_bot.db

# Сколько уникальных товаров + включённые уведомления = активация
ITEMS_THRESHOLD=2
